    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
