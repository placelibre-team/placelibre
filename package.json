{
  "name": "placelibre",
  "version": "0.1.0",
  "private": true,
  "description": "PlaceLibre : appli web (dossier public/) et son enveloppe iPhone avec Capacitor.",
  "scripts": {
    "ios:preparer": "node outils/preparer-ios.mjs",
    "ios:synchroniser": "npm run ios:preparer && cap sync ios",
